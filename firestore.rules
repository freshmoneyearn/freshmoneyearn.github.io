rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'freshmoneyearn@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true; // Public profiles allowed for sponsor lookup and downline stats
      allow create, update: if true; // Allow new registration and payment proof updates
      allow delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{txnId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Withdrawals collection
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // System Settings collection
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
